    <blq>model\oceanload</blq>
    <eop>model\poleut1</eop>
    <bias>gnss\CAS0MGXRAP_20233050000_01D_01D_DCB.BSX</bias>
    <ifcb>gnss\ifcb_2023305</ifcb>
    <upd>
      upd\upd_wl_2023305_G upd\upd_wl_2023305_E upd\upd_wl_2023305_C
      upd\upd_nl_2023305_G upd\upd_nl_2023305_E upd\upd_nl_2023305_C
